# --- Descansa · variables de entorno ---
# Copia este archivo a ".env" y rellena lo que quieras activar.
# La app FUNCIONA SIN NADA de esto (modo local con localStorage).

# ------------------------------------------------------------------
# Firebase (cuentas + sincronización en la nube).
# Si rellenas las 6 variables, la app usa Firebase automáticamente.
# Créalas en https://console.firebase.google.com -> Configuración del proyecto.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# EmailJS (opcional): recibir por correo los mensajes de contacto.
# https://www.emailjs.com  -> Email Services / Email Templates.
# ------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ------------------------------------------------------------------
# Google AdSense (opcional): anuncios reales en el tier gratuito.
# Requiere cuenta aprobada y dominio propio. Formato: ca-pub-XXXXXXXX
# Sin esto, se muestran espacios placeholder listos para AdSense.
# ------------------------------------------------------------------
VITE_ADSENSE_CLIENT=
