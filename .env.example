# ============================================================
# Pulso — variables de entorno (ejemplo)
# Copiá a .env.local y completá cuando conectes servicios reales.
# Mientras estas queden vacías, la app corre con datos mock.
# ============================================================

# Supabase (Postgres + Auth). Sólo la anon key va al cliente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic — se usa SÓLO desde el backend/edge function que genera
# el insight semanal. NUNCA exponer esta clave en el cliente.
ANTHROPIC_API_KEY=

# Stripe — pk_ es pública (cliente); sk_ y whsec_ van sólo en backend.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
